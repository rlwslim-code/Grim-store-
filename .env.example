PORT=3000
SESSION_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
STORE_OWNER_EMAIL=YOUR_EMAIL_HERE
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=GRIM Orders <orders@example.com>

# Owner Studio (/admin.html)
ADMIN_PASSWORD=replace-with-a-long-private-password
# For persistent hosting, point this to a persistent disk/volume, e.g. /data
DATA_DIR=
NODE_ENV=production
